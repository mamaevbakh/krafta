{
  "name": "tasnif",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "catalog:import": "uv run --with openpyxl --with certifi scripts/import_catalog.py",
    "catalog:names": "uv run --with openpyxl --with certifi scripts/import_names.py",
    "catalog:packages": "uv run --with openpyxl --with certifi scripts/import_packages.py",
    "catalog:inactive": "uv run --with openpyxl --with certifi scripts/import_inactive.py",
    "catalog:backfill": "uv run --with truststore --with certifi scripts/backfill_details.py",
    "catalog:sync": "uv run --with openpyxl --with certifi --with truststore --with 'psycopg[binary]' scripts/sync_catalog.py",
    "search:refresh": "uv run --with certifi scripts/refresh_search.py",
    "search:embed": "uv run --with certifi scripts/embed_documents.py",
    "search:score": "uv run --with certifi eval/score_tasnif.py",
    "search:score-official": "python3 eval/score_official.py",
    "search:terms": "uv run --with certifi scripts/everyday_terms.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@supabase/supabase-js": "^2.81.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^3.6.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
