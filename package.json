{
  "name": "krafta-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:krafta": "pnpm --filter krafta dev",
    "dev:krafta-pay": "pnpm --filter krafta-pay dev",
    "dev:krafta-auth": "pnpm --filter krafta-auth dev",
    "dev:krafta-docs": "pnpm --filter krafta-docs dev",
    "build": "pnpm -r build",
    "build:krafta": "pnpm --filter krafta build",
    "build:krafta-docs": "pnpm --filter krafta-docs build",
    "start:krafta": "pnpm --filter krafta start",
    "start:krafta-docs": "pnpm --filter krafta-docs start",
    "lint": "pnpm -r lint"
  },
  "dependencies": {},
  "devDependencies": {},
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
